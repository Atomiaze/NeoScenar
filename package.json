{
  "name": "neoscenar",
  "productName": "NeoScenar",
  "version": "0.1.0",
  "description": "Logiciel libre d'écriture de scénarios pour les étudiants en audio-visuel.",
  "author": "David Delepinne",
  "homepage": "https://github.com/Atomiaze/NeoScenar",
  "desktopName": "neoscenar.desktop",
  "license": "GPL-3.0-or-later",
  "private": true,
  "main": "out/main/index.js",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "postinstall": "install-electron",
    "dev": "electron-vite dev",
    "build": "npm run typecheck && electron-vite build",
    "build:mac": "npm run build && electron-builder --mac",
    "build:win": "npm run build && electron-builder --win",
    "build:linux": "npm run build && electron-builder --linux",
    "build:addon": "node scripts/addon.mjs build",
    "start": "electron-vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:addon": "node scripts/addon.mjs test",
    "lint": "eslint . && npm run typecheck && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json && tsc --noEmit -p packages/fountain/tsconfig.json && tsc -p packages/fountain/tests/tsconfig.json && tsc --noEmit -p packages/pdf-scenario/tsconfig.json && tsc -p packages/pdf-scenario/tests/tsconfig.json && tsc --noEmit -p packages/pdf-storyboard/tsconfig.json && tsc -p packages/pdf-storyboard/tests/tsconfig.json && tsc --noEmit -p packages/pdf-planning/tsconfig.json && tsc -p packages/pdf-planning/tests/tsconfig.json",
    "fountain:demo": "node scripts/fountain-demo.mjs",
    "fountain:pages": "node scripts/pagination-demo.mjs",
    "couleurs": "node scripts/couleurs.mjs",
    "pilote": "node scripts/pilotage/pilote.mjs",
    "pdf:exemple": "node scripts/pdf-exemple.mjs",
    "pdf:storyboard:exemple": "node scripts/pdf-storyboard-exemple.mjs",
    "pdf:planning:exemple": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/pdf-planning-exemple.mjs"
  },
  "devDependencies": {
    "@codemirror/autocomplete": "6.20.4",
    "@codemirror/commands": "6.11.1",
    "@codemirror/search": "6.7.2",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.15",
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/sortable": "10.0.0",
    "@dnd-kit/utilities": "3.2.2",
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "electron": "45.3.3",
    "electron-builder": "26.18.0",
    "electron-vite": "6.0.0",
    "eslint": "10.15.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.14.0",
    "pdfjs-dist": "6.5.438",
    "prettier": "3.10.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0",
    "vite": "8.3.8",
    "vitest": "5.1.0",
    "yaml": "2.9.1"
  },
  "dependencies": {
    "diff": "^9.0.0"
  }
}
